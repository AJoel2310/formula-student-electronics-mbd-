# ====================================================================
# Official GitHub MATLAB & Simulink .gitignore Template
# ====================================================================

# Autosave files generated by the MATLAB Editor
*.asv
*.m~
*.autosave

# Simulink model recovery/backup files
*.slx.r*
*.mdl.r*

# Derived content-obscured files (P-code)
*.p

# Compiled MEX binaries (platform-specific compiled C/C++)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives (MATLAB Compiler)
*.ctf

# Generated helpsearch folders
helpsearch*/

# ====================================================================
# CRITICAL: Simulink Code Generation & Cache Folders (Must Ignore!)
# ====================================================================
slprj/
sccprj/
codegen/
*DerivedData/

# Simulink Cache files (introduced in newer MATLAB versions to speed up loading)
*.slxc
*.mexmaci64
*.mexglnxa64
*.mexw64

# ====================================================================
# General Operating System / IDE Trash
# ====================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
